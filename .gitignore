# ---- Local-only folders ----------------------------------------------------
# planning notes, third-party reference code, unused analyses
.plans/
code/extra/
/extra/
code/scripts/exploration/
# poster, old WACV paper, untouched AAAI author kit and its Word templates
poster/
papers/poster/
papers/wacv_paper/
papers/AAAI_paper/
papers/**/Word/
# unused figures and pre-migration backups
papers/AAAI_workshop_paper/Figures/unused/
papers/IEEE_paper/*_pre_migration.*

# ---- Images ----------------------------------------------------------------
# PNGs stay local (large exports). Only the PNG figures the papers use are tracked.
*.png
*.PNG
!papers/IEEE_paper/images/architecture.png
!papers/IEEE_paper/images/bridge.png
!papers/IEEE_paper/images/dip.png
!papers/IEEE_paper/images/roi_mask_flatmap.png
!papers/AAAI_workshop_paper/Figures/architecture.png
!papers/AAAI_workshop_paper/Figures/bridge.png
!papers/AAAI_workshop_paper/Figures/dip.png
!papers/AAAI_workshop_paper/Figures/roi_mask_flatmap.png

# ---- PDFs ------------------------------------------------------------------
# Compiled papers are build output. Figure PDFs are sources.
*.pdf
!papers/**/Figures/*.pdf
!papers/IEEE_paper/images/size_sweep_valcos_wide.pdf

# ---- LaTeX build files -----------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.xdv

# ---- Python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# ---- Secrets (Modal / Hugging Face tokens) ---------------------------------
.env

# ---- Editors and OS --------------------------------------------------------
.claude/
.vscode/
.idea/
.DS_Store
# Finder duplicates, e.g. "DIP3 2.png"
* [0-9].*
*.zip
