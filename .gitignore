# old IEEE and WACV versions of the paper
papers/IEEE_paper/
papers/wacv_paper/

# raster images are kept locally, not in git (figure PDFs are still tracked)
*.png
*.PNG

# pristine AAAI author kit (the paper lives in papers/AAAI_workshop_paper/)
papers/AAAI_paper/

# third-party reference code, papers and examples (not part of this project)
code/extra/

# local planning notes and specs
.plans/

# exploratory analyses and figures not used in the paper (kept locally)
code/v2/scripts/exploration/
papers/AAAI_workshop_paper/Figures/unused/

# editor / assistant local state
.vscode/
.idea/
.claude/

# python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# secrets (Modal / HF tokens)
.env

# archives / backups
*.zip
# macOS Finder duplicates, e.g. "DIP3 2.png"
* [0-9].*

# AAAI author-kit Word templates (paper is written in LaTeX)
papers/**/Word/

# latex build artifacts
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.bcf
*.run.xml
*.xdv

# compiled PDFs are build output, but figure PDFs are paper sources
*.pdf
!papers/**/Figures/*.pdf

